# Copy to .env (never committed). Only EXPO_PUBLIC_* values are readable by app code. Restart Metro after changing
# this file: `pnpm start --clear`.
#
# Care Team (Phase 7). Local Supabase: `supabase status` prints the URL and the publishable key; the iOS Simulator
# reaches your Mac at 127.0.0.1. A real phone needs your Mac's network address instead (e.g. http://192.168.1.20:54321).
# Production: Supabase dashboard -> Project Settings -> API Keys -> the PUBLISHABLE key (starts sb_publishable_).
# Only the publishable key belongs in the app; the Supabase secret key must never be in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Older projects: EXPO_PUBLIC_SUPABASE_ANON_KEY is read if the publishable key is empty.)
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PORTAL_URL=https://<your-portal>.vercel.app
# Food lookup (Phase 4): a free USDA FoodData Central key. Open Food Facts asks apps to name a contact address in
# their requests; leave empty to send "no-contact-set".
EXPO_PUBLIC_USDA_FDC_API_KEY=
# EXPO_PUBLIC_CONTACT_EMAIL=you@example.com
# Not used: Fitbit was skipped (its API is shutting down, DECISIONS #40).
EXPO_PUBLIC_FITBIT_CLIENT_ID=
# Optional: change the app id if app.emolens.mobile is taken in your Apple/Google account.
# EMOLENS_BUNDLE_ID=com.yourname.emolens
