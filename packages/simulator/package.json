{
  "name": "@emolens/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./scenarios/default.json": "./scenarios/default.json"
  },
  "dependencies": {
    "@emolens/engine": "workspace:*",
    "@emolens/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "node --import tsx --test test/*.test.ts",
    "sim": "tsx src/run.ts"
  }
}
